 class generator;
      transaction tr;
      mailbox gen_to_drv;
      int count;
      event done;

      function new(mailbox gen_to_drv);
        this.gen_to_drv = gen_to_drv;
      endfunction

      task run();
        for(int i = 0; i < count; i++) begin
          tr = new();
          tr.randomize();

          // Batch in 16 (8 writes, then 8 reads)
          if ( (i % 16) < 8 ) begin
            tr.wr_en = 1; tr.re_en = 0;
          end else begin
            tr.wr_en = 0; tr.re_en = 1;
          end

          // PUTTING THE DISPLAY BACK SO YOU CAN SEE IT!
          $display("[GENERATOR] wr_en=%0d | re_en=%0d | data_in=%0d", tr.wr_en, tr.re_en, tr.data_in);
          gen_to_drv.put(tr);
        end
        -> done;
      endtask
    endclass
